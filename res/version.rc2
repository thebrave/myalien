// Shared version resource. The including .rc defines MYALIEN_RC_DESCRIPTION and
// MYALIEN_RC_FILENAME; CMake passes MYALIEN_VERSION_MAJOR/MINOR/PATCH and MYALIEN_VERSION.

#include <winres.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MYALIEN_VERSION_MAJOR, MYALIEN_VERSION_MINOR, MYALIEN_VERSION_PATCH, 0
 PRODUCTVERSION MYALIEN_VERSION_MAJOR, MYALIEN_VERSION_MINOR, MYALIEN_VERSION_PATCH, 0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "MyAlien"
            VALUE "FileDescription", MYALIEN_RC_DESCRIPTION
            VALUE "FileVersion", MYALIEN_VERSION
            VALUE "InternalName", MYALIEN_RC_FILENAME
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", MYALIEN_RC_FILENAME
            VALUE "ProductName", "MyAlien"
            VALUE "ProductVersion", MYALIEN_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// Application icon, resource ID 1 (Explorer uses the lowest ID; the tray loads it by this ID).
1 ICON "myalien.ico"
